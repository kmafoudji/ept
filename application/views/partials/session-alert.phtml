<?php
// Shows, then clears, the message a controller left in the 'alertSpace'
// session namespace. For pages whose layout does not show it (the 'home'
// layout of the login and password pages).
?>
<?php
$alertMsgInit = new Zend_Session_Namespace('alertSpace');
$alertMessage = '';
$alertStatus  = '';
if (isset($alertMsgInit->message) && $alertMsgInit->message !== '') {
    $alertMessage = (string) $alertMsgInit->message;
    $alertStatus  = isset($alertMsgInit->status) ? (string) $alertMsgInit->status : '';
    $alertMsgInit->message = '';
    unset($alertMsgInit->message);
    if (isset($alertMsgInit->status)) {
        unset($alertMsgInit->status);
    }
}
$alertClass = 'alert-info';
if ($alertStatus === 'success') {
    $alertClass = 'alert-success';
} elseif ($alertStatus === 'failure') {
    $alertClass = 'alert-danger';
}
?>
	<?php if ($alertMessage !== ''): ?>
		<div class="alert <?php echo $alertClass; ?> alert-dismissible" role="alert" style="max-width:630px;margin:0 auto 10px auto;">
			<button type="button" class="close" data-dismiss="alert" aria-label="Close" onclick="this.parentNode.style.display='none';return false;" style="background:none;border:none;float:right;font-size:20px;line-height:1;cursor:pointer;">&times;</button>
			<?php echo htmlspecialchars($alertMessage, ENT_QUOTES, 'UTF-8'); ?>
		</div>
	<?php endif; ?>
